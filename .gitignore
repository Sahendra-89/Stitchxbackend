server/data/resumes/*
!server/data/resumes/.gitkeep
server/data/documents/*
!server/data/documents/.gitkeep

# Test outputs & scratch files
server/test_output/*
!server/test_output/.gitkeep

# System & Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
